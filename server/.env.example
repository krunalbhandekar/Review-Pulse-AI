# ============================================================================
# Server secrets / deployment-specific values
# ============================================================================
# Everything else (APP_NAME, PORT, LOG_LEVEL, session cookie name + TTL,
# MCP retry tuning, Groq model, scheduler poll interval, …) lives in
# app/config/settings.py as typed dataclasses. Do not duplicate those here.
# ============================================================================

# Deployment environment. The ONLY source of truth for the production flag.
# Accepted values: PRODUCTION | DEVELOPMENT (case-insensitive).
# - ENVIRONMENT=PRODUCTION  -> IS_PRODUCTION=true
# - anything else / missing -> IS_PRODUCTION=false (defaults to DEVELOPMENT)
ENVIRONMENT=DEVELOPMENT

# MongoDB Atlas — full URI *including* the default DB name as the path.
# The DB name is parsed out of this URI; there is no separate MONGODB_DB.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/mt_review_intelligence

# Signs the session cookie. Rotating this logs every user out.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Google OAuth client (Web application). The same client is used by mcp/.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match an Authorised redirect URI in Google Cloud console.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Where to bounce the browser after login / logout. CORS allowed
# origins are derived from these — no separate FRONTEND_ORIGINS variable.
POST_LOGIN_REDIRECT=http://localhost:5173/dashboard
POST_LOGOUT_REDIRECT=http://localhost:5173/

# Downstream MCP service.
MCP_SERVER_URL=http://localhost:9000
# Must match MCP_SHARED_SECRET in multi-tenant/mcp/.env
MCP_SHARED_SECRET=

# Groq summarisation (model name is a code constant; only the key is env).
GROQ_API_KEY=
