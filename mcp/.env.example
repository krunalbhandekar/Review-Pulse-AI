# ============================================================================
# MCP secrets / deployment-specific values
# ============================================================================
# Everything else (APP_NAME, PORT, LOG_LEVEL, Google scopes, token URL,
# collection names, …) lives in app/config.py as typed dataclasses /
# class constants. Do not duplicate those here.
# ============================================================================

# Deployment environment. The ONLY source of truth for the production flag.
# Accepted values: PRODUCTION | DEVELOPMENT (case-insensitive).
# - ENVIRONMENT=PRODUCTION  -> IS_PRODUCTION=true
# - anything else / missing -> IS_PRODUCTION=false (defaults to DEVELOPMENT)
ENVIRONMENT=DEVELOPMENT

# Same Mongo URI the server uses — full URI *including* the DB name as
# the path component. There is no separate MONGODB_DB env var.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/mt_review_intelligence

# Same Google OAuth client the server uses; required to refresh
# per-user access tokens (offline access).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Symmetric secret the server attaches as X-MCP-Secret on every request.
# Must match MCP_SHARED_SECRET in multi-tenant/server/.env.
MCP_SHARED_SECRET=
