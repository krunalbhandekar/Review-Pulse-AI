# Keep the Render build context small. Same shape as .gitignore but
# Render-specific (some local dev artefacts are checked in for tooling
# but never wanted on the build host).

venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets / local config — Render reads env from the dashboard, never
# from a committed file.
.env
.env.*
!.env.example

# Editor / OS junk
.DS_Store
.idea/
.vscode/

# Docs / scripts that don't need to ship to the runtime.
README.md
Makefile
run.sh
